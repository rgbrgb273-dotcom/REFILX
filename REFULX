-- ----------------------------------------------------
-- 3. ฟังก์ชันการทำงานหลัก (Auto-Farm Loop)
-- ----------------------------------------------------
local function startFarm()
    task.spawn(function()
        while _G.AutoFarm do
            local character = LocalPlayer.Character
            if character then
                -- ค้นหาอุปกรณ์ในตัวและในกระเป๋า
                local tool = character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                
                -- หากยังไม่ได้ถืออุปกรณ์ ให้หยิบจากกระเป๋ามาถือ
                if tool then
                    if tool.Parent == LocalPlayer.Backpack then
                        tool.Parent = character
                    end
                    -- สั่งให้อุปกรณ์ทำงาน (กดใช้งาน)
                    tool:Activate()
                end
            end
            
            -- หน่วงเวลาในการกด (0.1 วินาที)
            task.wait(0.1)
        end
    end)
end

-- ----------------------------------------------------
-- 4. ระบบการกดปุ่มเพื่อ สลับสถานะ (เปิด/ปิด)
-- ----------------------------------------------------
ToggleBtn.MouseButton1Click:Connect(function()
    _G.AutoFarm = not _G.AutoFarm -- สลับค่า true / false
    
    if _G.AutoFarm then
        ToggleBtn.Text = "สถานะ: กำลังทำงาน (ON)"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80) -- เปลี่ยนเป็นสีเขียว
        startFarm()
    else
        ToggleBtn.Text = "สถานะ: ปิดอยู่ (OFF)"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60) -- เปลี่ยนเป็นสีแดง
    end
end)
