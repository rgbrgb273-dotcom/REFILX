local function startFarm()
    task.spawn(function()
        while _G.AutoFarm do
            local character = LocalPlayer.Character
            if character then
                local tool = character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                if tool then
                    if tool.Parent == LocalPlayer.Backpack then
                        tool.Parent = character
                    end
                    tool:Activate()
                end
            end
            task.wait(0.1)
        end
    end)
end

ToggleBtn.MouseButton1Click:Connect(function()
    _G.AutoFarm = not _G.AutoFarm
    if _G.AutoFarm then
        ToggleBtn.Text = "Status: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        startFarm()
    else
        ToggleBtn.Text = "Status: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    end
end)
